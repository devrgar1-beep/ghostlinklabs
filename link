#!/usr/bin/env zsh
# GhostLink CLI Wrapper
# Usage: ./link [command] [options]

set -e

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PYTHON_BIN="$SCRIPT_DIR/.venv/bin/python"
GHOSTLINK_MODULE="ghostlink.link_cli"

# Check if virtual environment exists
if [[ ! -f "$PYTHON_BIN" ]]; then
    echo "❌ Error: Python virtual environment not found at $PYTHON_BIN"
    echo "Run: cd $SCRIPT_DIR && python3 -m venv .venv"
    exit 1
fi

# Run the Link CLI
"$PYTHON_BIN" -m "$GHOSTLINK_MODULE" "$@"
