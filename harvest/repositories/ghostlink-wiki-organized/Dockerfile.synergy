FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set up Python environment
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy triad synergy code
COPY triad_synergy.py ./
COPY triad_synergy.ini ./

# Create triad shared directory
RUN mkdir -p /triad

# Expose synergy hub port
EXPOSE 7422

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:7422/health || exit 1

# Default command - run synergy hub
CMD ["python", "triad_synergy.py", "--hub"]
