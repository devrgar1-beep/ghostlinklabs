\f0\b0\fs32 \cf0 Pseudo-flow for engine given a graph + input:\
\pard\pardeftab720\partightenfactor0

\f12\fs28 \cf0 \
\pard\pardeftab720\partightenfactor0
\cf0 \cb13 function run_graph(graph: ExecutionGraph, user_input: any):\
    ctx = \{\}\
    trace = []\
\
    // seed context\
    ctx["user_input"] = user_input\
\
    for step in graph.steps (in defined order):\
        // read inputs\
        inputs = \{ name: ctx[name] for name in step.inputs \}\
\
        // execute step based on kind\
        result, event = execute_step(step, inputs)\
\
        // write outputs to context\
        for key, value in result.items():\
            ctx[key] = value\
\
        // append trace event\
        trace.append(event)\
\
    // assume one step builds Episode and stores it\
    episode = ctx["episode"]          // produced by store_episode step\
    return episode, trace\
\pard\pardeftab720\sa80\partightenfactor0

