\f12\fs28 \cf0 \
\pard\pardeftab720\partightenfactor0
\cf0 \cb13 TraceEvent \{\
  "step_id": "string",            // must match ExecutionGraphStep.id\
  "kind": "string",               // "info", "call", "result", "metric", "decision", "persist", "error"\
  "ts": "string",                 // optional ISO-8601 timestamp\
  "summary": "string",            // short natural language summary\
  "data": \{                       // structured payload\
    // for "call": \{agent, input_ref\}\
    // for "result": \{agent, truncated_output\}\
