\f6\b\fs36 \cf0 2.2 Execution algorithm (pseudocode, deeper)\
\pard\pardeftab720\partightenfactor0

\f12\b0\fs28 \cf0 \
\pard\pardeftab720\partightenfactor0
\cf16 \cb13 def\cf0  \cf17 run_graph\cf0 (graph: ExecutionGraph, user_input: \cf18 dict\cf0 ) -> \cf18 tuple\cf0 [Episode, \cf18 list\cf0 [TraceEvent]]:\
    context: \cf18 dict\cf0 [\cf18 str\cf0 , \cf14 Any\cf0 ] = \{\}\
    trace: \cf18 list\cf0 [TraceEvent] = []\
\
    \cf19 # seed\cf0 \
    context[\cf15 "user_input"\cf0 ] = user_input\
\
    \cf16 for\cf0  step \cf16 in\cf0  graph.steps:\
        \cf19 # gather inputs\cf0 \
        inputs = \{\}\
        \cf16 for\cf0  key \cf16 in\cf0  step.inputs:\
            \cf16 if\cf0  key \cf16 not\cf0  \cf16 in\cf0  context:\
                \cf19 # emit error and stop\cf0 \
                event = TraceEvent(\
                    step_id=step.\cf18 id\cf0 ,\
                    kind=\cf15 "error"\cf0 ,\
                    summary=\cf15 f"Missing input key '\{key\}\cf0 ' for step \{step.\cf18 id\cf0 \}",\
                    data=\{\cf15 "missing_key"\cf0 : key\}\
                )\
                trace.append(event)\
                \cf16 raise\cf0  RuntimeError(\cf15 f"Missing input '\{key\}\cf0 ' for step \{step.\cf18 id\cf0 \}")\
            inputs[key] = context[key]\
\
        \cf19 # execute according to kind\cf0 \
        result, events = execute_step(step, inputs)\
\
        \cf19 # update context\cf0 \
        \cf16 for\cf0  out_key, value \cf16 in\cf0  result.items():\
            context[out_key] = value\
\
        \cf19 # append trace events\cf0 \
        trace.extend(events)\
\
    \cf19 # ensure we produced an Episode\cf0 \
    \cf16 if\cf0  \cf15 "episode"\cf0  \cf16 not\cf0  \cf16 in\cf0  context:\
        \cf16 raise\cf0  RuntimeError(\cf15 "Graph run completed without building episode"\cf0 )\
\
    \cf16 return\cf0  context[\cf15 "episode"\cf0 ], trace\
\pard\pardeftab720\sa80\partightenfactor0

\f0\fs32 \cf0 \cb1 Key idea: 
\f8\fs28 \cb12 execute_step
\f0\fs32 \cb1  is a dispatcher on 
\f8\fs28 \cb12 step.kind
\f0\fs32 \cb1 .\
\pard\pardeftab720\partightenfactor0
\cf0 \
\pard\pardeftab720\sa80\partightenfactor0

\f6\b\fs36 \cf0 2.3 Step semantics (per kind)\
\pard\pardeftab720\sa80\partightenfactor0

\f0\b0\fs32 \cf0 Let\'92s define what 
\f8\fs28 \cb12 execute_step
\f0\fs32 \cb1  does for each 
\f8\fs28 \cb12 kind
\f0\fs32 \cb1 .\
\pard\pardeftab720\partightenfactor0

\f3\b \cf0 2.3.1 
\f8\b0\fs28 \cb12 transform
\f3\b\fs32 \cb1 \
\pard\pardeftab720\sa80\partightenfactor0

\f0\b0 \cf0 Purpose: deterministic transformation of data (no external calls ideally).\
\pard\pardeftab720\sa320\partightenfactor0
\cf0 Input: any data from context.\uc0\u8232 Output: new data into context.\
Example: 
\f8\fs28 \cb12 parse_input
\f0\fs32 \cb1  step.\
Pseudocode:\
\pard\pardeftab720\partightenfactor0

\f12\fs28 \cf0 \
\pard\pardeftab720\partightenfactor0
\cf16 \cb13 def\cf0  \cf17 execute_transform\cf0 (step, inputs):\
    \cf19 # You can pick a pure function based on step.id or step.params\cf0 \
    result = \{\}\
    \cf19 # Example: take "user_input" and wrap into Input object\cf0 \
    \cf16 if\cf0  step.\cf18 id\cf0  == \cf15 "parse_input"\cf0 :\
        raw = inputs[\cf15 "user_input"\cf0 ]\
        result[\cf15 "task_spec"\cf0 ] = normalize_input(raw, step.params)\
    \cf16 else\cf0 :\
        result[step.outputs[\cf14 0\cf0 ]] = generic_transform(inputs, step.params)\
\
    event = TraceEvent(\
        step_id=step.\cf18 id\cf0 ,\
        kind=\cf15 "info"\cf0 ,\
        summary=\cf15 "Ran transform step"\cf0 ,\
        data=\{\cf15 "inputs_keys"\cf0 : \cf18 list\cf0 (inputs.keys()), \cf15 "outputs_keys"\cf0 : \cf18 list\cf0 (result.keys())\}\
    )\
    \cf16 return\cf0  result, [event]\
\pard\pardeftab720\partightenfactor0

\f3\b\fs32 \cf0 \cb1 2.3.2 
\f8\b0\fs28 \cb12 fanout
\f3\b\fs32 \cb1 \
\pard\pardeftab720\sa80\partightenfactor0

\f0\b0 \cf0 Purpose: run multiple agents on a common input.\
\pard\pardeftab720\sa320\partightenfactor0
\cf0 Inputs: something like 
\f8\fs28 \cb12 task_spec
\f0\fs32 \cb1 .\uc0\u8232 Outputs: 
\f8\fs28 \cb12 agent_outputs
\f0\fs32 \cb1 .\
Pseudocode:\
\pard\pardeftab720\partightenfactor0

\f12\fs28 \cf0 \
\pard\pardeftab720\partightenfactor0
\cf16 \cb13 def\cf0  \cf17 execute_fanout\cf0 (step, inputs):\
    task = inputs[\cf15 "task_spec"\cf0 ]\
    outputs = []\
\
    events = []\
\
    \cf16 for\cf0  agent_name \cf16 in\cf0  step.agents:\
        agent = lookup_agent(agent_name)\
        call_event = TraceEvent(\
            step_id=step.\cf18 id\cf0 ,\
            kind=\cf15 "call"\cf0 ,\
            summary=\cf15 f"Calling agent \{agent_name\}\cf0 ",\
            data=\{\cf15 "agent"\cf0 : agent_name\}\
        )\
        events.append(call_event)\
\
        \cf19 # This is where model/tool call happens\cf0 \
        out = run_agent(agent, task, step.params)\
\
        outputs.append(out)\
\
        result_event = TraceEvent(\
            step_id=step.\cf18 id\cf0 ,\
            kind=\cf15 "result"\cf0 ,\
            summary=\cf15 f"Got output from agent \{agent_name\}\cf0 ",\
            data=\{\cf15 "agent"\cf0 : agent_name, \cf15 "truncated_answer"\cf0 : truncate(out[\cf15 "answer"\cf0 ])\}\
        )\
        events.append(result_event)\
\
    \cf16 return\cf0  \{\cf15 "agent_outputs"\cf0 : outputs\}, events\
\pard\pardeftab720\partightenfactor0

\f3\b\fs32 \cf0 \cb1 2.3.3 
\f8\b0\fs28 \cb12 metric
\f3\b\fs32 \cb1 \
\pard\pardeftab720\sa80\partightenfactor0

\f0\b0 \cf0 Purpose: compute metrics like disagreement based on prior outputs.\
\pard\pardeftab720\sa320\partightenfactor0
\cf0 Inputs: e.g. 
\f8\fs28 \cb12 agent_outputs
\f0\fs32 \cb1 .\uc0\u8232 Outputs: e.g. 
\f8\fs28 \cb12 disagreement
\f0\fs32 \cb1 .\
Pseudocode:\
\pard\pardeftab720\partightenfactor0

\f12\fs28 \cf0 \
\pard\pardeftab720\partightenfactor0
\cf16 \cb13 def\cf0  \cf17 execute_metric\cf0 (step, inputs):\
    outs = inputs[\cf15 "agent_outputs"\cf0 ]\
    score, details = compute_disagreement(outs, step.params)\
\
    disag = \{\
        \cf15 "score"\cf0 : score,\
        \cf15 "method"\cf0 : step.params.get(\cf15 "method"\cf0 , \cf15 "default"\cf0 ),\
        \cf15 "details"\cf0 : details\
    \}\
\
    event = TraceEvent(\
        step_id=step.\cf18 id\cf0 ,\
        kind=\cf15 "metric"\cf0 ,\
        summary=\cf15 f"Computed disagreement score \{score:\cf14 .3\cf0 f\}",\
        data=\{\cf15 "score"\cf0 : score\}\
    )\
\
    \cf16 return\cf0  \{\cf15 "disagreement"\cf0 : disag\}, [event]\
\pard\pardeftab720\partightenfactor0

\f3\b\fs32 \cf0 \cb1 2.3.4 
\f8\b0\fs28 \cb12 decision
\f3\b\fs32 \cb1 \
\pard\pardeftab720\sa80\partightenfactor0

\f0\b0 \cf0 Purpose: choose final answer / classification.\
\pard\pardeftab720\sa320\partightenfactor0
\cf0 Inputs: 
\f8\fs28 \cb12 agent_outputs
\f0\fs32 \cb1 , 
\f8\fs28 \cb12 disagreement
\f0\fs32 \cb1 , maybe 
\f8\fs28 \cb12 task_spec
\f0\fs32 \cb1 .\uc0\u8232 Outputs: 
\f8\fs28 \cb12 final_decision
\f0\fs32 \cb1 .\
Pseudocode:\
\pard\pardeftab720\partightenfactor0

\f12\fs28 \cf0 \
\pard\pardeftab720\partightenfactor0
\cf16 \cb13 def\cf0  \cf17 execute_decision\cf0 (step, inputs):\
    agent_outputs = inputs[\cf15 "agent_outputs"\cf0 ]\
    disagreement = inputs[\cf15 "disagreement"\cf0 ]\
\
    decision = choose_final_decision(agent_outputs, disagreement, step.params)\
\
    event = TraceEvent(\
        step_id=step.\cf18 id\cf0 ,\
        kind=\cf15 "decision"\cf0 ,\
        summary=\cf15 f"Chose final answer from agent \{decision['source_agent'\cf0 ]\}",\
        data=\{\cf15 "source_agent"\cf0 : decision[\cf15 "source_agent"\cf0 ], \cf15 "confidence"\cf0 : decision.get(\cf15 "confidence"\cf0 )\}\
    )\
\
    \cf16 return\cf0  \{\cf15 "final_decision"\cf0 : decision\}, [event]\
\pard\pardeftab720\partightenfactor0

\f3\b\fs32 \cf0 \cb1 2.3.5 
\f8\b0\fs28 \cb12 persist
\f3\b\fs32 \cb1 \
\pard\pardeftab720\sa80\partightenfactor0

\f0\b0 \cf0 Purpose: build an Episode and store it.\
\pard\pardeftab720\sa320\partightenfactor0
\cf0 Inputs: 
\f8\fs28 \cb12 user_input
\f0\fs32 \cb1 , 
\f8\fs28 \cb12 agent_outputs
\f0\fs32 \cb1 , 
\f8\fs28 \cb12 disagreement
\f0\fs32 \cb1 , 
\f8\fs28 \cb12 final_decision
\f0\fs32 \cb1 .\uc0\u8232 Outputs: 
\f8\fs28 \cb12 episode
\f0\fs32 \cb1 , 
\f8\fs28 \cb12 episode_id
\f0\fs32 \cb1 .\
Pseudocode:\
\pard\pardeftab720\partightenfactor0

\f12\fs28 \cf0 \
\pard\pardeftab720\partightenfactor0
\cf16 \cb13 def\cf0  \cf17 execute_persist\cf0 (step, inputs):\
    \cf19 # Here you construct Episode from context\cf0 \
    episode = build_episode_from_context(inputs, step.params)\
    episode_id = save_episode(episode)   \cf19 # backend call\cf0 \
\
    events = [\
