\f12\fs28 \cf0 \
\pard\pardeftab720\partightenfactor0
\cf16 \cb13 def\cf0  \cf17 episode_to_training_rows\cf0 (ep: Episode) -> \cf14 List\cf0 [\cf14 Dict\cf0 ]:\
    rows = []\
    \cf16 for\cf0  out \cf16 in\cf0  ep.outputs:\
        rows.append(\{\
            \cf15 "input"\cf0 : ep.\cf18 input\cf0 ,\
            \cf15 "agent"\cf0 : out.agent,\
            \cf15 "agent_answer"\cf0 : out.answer,\
            \cf15 "agent_label"\cf0 : out.label,\
            \cf15 "final_answer"\cf0 : ep.final_decision.answer,\
            \cf15 "final_label"\cf0 : label_from_final(ep.final_decision), \cf19 # if exists\cf0 \
            \cf15 "disagreement_score"\cf0 : ep.disagreement.score,\
            \cf15 "metadata"\cf0 : ep.metadata\
        \})\
    \cf16 return\cf0  rows\
