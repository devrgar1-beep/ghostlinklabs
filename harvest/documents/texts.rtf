\cf19 \cb13 # ghostlink_docs/build_pdf.py\cf0 \
\pard\pardeftab720\partightenfactor0
\cf16 from\cf0  __future__ \cf16 import\cf0  annotations\
\cf16 import\cf0  subprocess\
\cf16 from\cf0  pathlib \cf16 import\cf0  Path\
\cf16 import\cf0  sys\
\
\cf16 from\cf0  docspec.load_from_yaml \cf16 import\cf0  load_document_from_yaml\
\cf16 from\cf0  docspec.render_md \cf16 import\cf0  render_document\
\
\
\cf16 def\cf0  \cf17 build_markdown\cf0 (yaml_path: Path, md_path: Path) -> \cf16 None\cf0 :\
    doc = load_document_from_yaml(\cf18 str\cf0 (yaml_path))\
    md_text = render_document(doc)\
\
    md_path.parent.mkdir(parents=\cf16 True\cf0 , exist_ok=\cf16 True\cf0 )\
    md_path.write_text(md_text, encoding=\cf15 "utf-8"\cf0 )\
    \cf18 print\cf0 (\cf15 f"[+] Wrote markdown: \{md_path\}\cf0 ")\
\
\
\cf16 def\cf0  \cf17 run_pandoc\cf0 (md_path: Path, pdf_path: Path) -> \cf16 None\cf0 :\
    pdf_path.parent.mkdir(parents=\cf16 True\cf0 , exist_ok=\cf16 True\cf0 )\
\
    \cf19 # You can tweak this command: template, fonts, margins, etc.\cf0 \
    cmd = [\
        \cf15 "pandoc"\cf0 ,\
        \cf18 str\cf0 (md_path),\
        \cf15 "-o"\cf0 ,\
        \cf18 str\cf0 (pdf_path),\
        \cf15 "--from=markdown"\cf0 ,\
        \cf15 "--pdf-engine=xelatex"\cf0 ,\
        \cf15 "--highlight-style=kate"\cf0 ,\
    ]\
    \cf18 print\cf0 (\cf15 f"[+] Running: \{' '\cf0 .join(cmd)\}")\
    result = subprocess.run(cmd, capture_output=\cf16 True\cf0 , text=\cf16 True\cf0 )\
\
    \cf16 if\cf0  result.returncode != \cf14 0\cf0 :\
        \cf18 print\cf0 (\cf15 "[!] Pandoc failed:"\cf0 )\
        \cf18 print\cf0 (result.stdout)\
        \cf18 print\cf0 (result.stderr, file=sys.stderr)\
        sys.exit(result.returncode)\
\
    \cf18 print\cf0 (\cf15 f"[+] Wrote PDF: \{pdf_path\}\cf0 ")\
\
\
\cf16 def\cf0  \cf17 main\cf0 ():\
    root = Path(__file__).parent\
    yaml_path = root / \cf15 "content"\cf0  / \cf15 "whiteletter.yaml"\cf0 \
    build_dir = root / \cf15 "build"\cf0 \
    md_path = build_dir / \cf15 "whiteletter.md"\cf0 \
    pdf_path = build_dir / \cf15 "whiteletter.pdf"\cf0 \
\
    build_markdown(yaml_path, md_path)\
    run_pandoc(md_path, pdf_path)\
\
\
\cf16 if\cf0  __name__ == \cf15 "__main__"\cf0 :\
    main()\
