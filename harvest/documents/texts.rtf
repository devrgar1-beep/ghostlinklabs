\cf19 \cb13 # ghostlink_docs/docspec/load_from_yaml.py\cf0 \
\pard\pardeftab720\partightenfactor0
\cf16 from\cf0  __future__ \cf16 import\cf0  annotations\
\cf16 from\cf0  typing \cf16 import\cf0  \cf14 Any\cf0 , \cf14 Dict\cf0 , \cf14 List\cf0 \
\cf16 from\cf0  dataclasses \cf16 import\cf0  dataclass\
\cf16 import\cf0  yaml\
\
\cf16 from\cf0  .models \cf16 import\cf0  Document, DocumentMeta, Section, Paragraph, BulletList, CodeBlock, Block\
\
\
\cf16 def\cf0  \cf17 _block_from_dict\cf0 (d: \cf14 Dict\cf0 [\cf18 str\cf0 , \cf14 Any\cf0 ]) -> Block:\
    btype = d.get(\cf15 "type"\cf0 )\
    \cf16 if\cf0  btype == \cf15 "paragraph"\cf0 :\
        \cf16 return\cf0  Paragraph(text=d[\cf15 "text"\cf0 ])\
    \cf16 if\cf0  btype == \cf15 "bullet_list"\cf0 :\
        \cf16 return\cf0  BulletList(items=\cf18 list\cf0 (d.get(\cf15 "items"\cf0 , [])))\
    \cf16 if\cf0  btype == \cf15 "code"\cf0 :\
        \cf16 return\cf0  CodeBlock(language=d.get(\cf15 "language"\cf0 , \cf15 ""\cf0 ), code=d.get(\cf15 "code"\cf0 , \cf15 ""\cf0 ))\
    \cf16 raise\cf0  ValueError(\cf15 f"Unknown block type in YAML: \{btype\}\cf0 ")\
\
\
\cf16 def\cf0  \cf17 _section_from_dict\cf0 (d: \cf14 Dict\cf0 [\cf18 str\cf0 , \cf14 Any\cf0 ]) -> Section:\
    title = d[\cf15 "title"\cf0 ]\
    raw_blocks = d.get(\cf15 "blocks"\cf0 , [])\
    raw_subsections = d.get(\cf15 "subsections"\cf0 , [])\
\
    blocks: \cf14 List\cf0 [Block] = [_block_from_dict(b) \cf16 for\cf0  b \cf16 in\cf0  raw_blocks]\
    subsections: \cf14 List\cf0 [Section] = [_section_from_dict(s) \cf16 for\cf0  s \cf16 in\cf0  raw_subsections]\
\
    \cf16 return\cf0  Section(title=title, blocks=blocks, subsections=subsections)\
\
\
\cf16 def\cf0  \cf17 load_document_from_yaml\cf0 (path: \cf18 str\cf0 ) -> Document:\
    \cf16 with\cf0  \cf18 open\cf0 (path, \cf15 "r"\cf0 , encoding=\cf15 "utf-8"\cf0 ) \cf16 as\cf0  f:\
        data = yaml.safe_load(f)\
\
    meta_raw = data[\cf15 "meta"\cf0 ]\
    meta = DocumentMeta(\
        title=meta_raw[\cf15 "title"\cf0 ],\
        author=meta_raw.get(\cf15 "author"\cf0 ),\
        date=meta_raw.get(\cf15 "date"\cf0 ),\
        keywords=\cf18 list\cf0 (meta_raw.get(\cf15 "keywords"\cf0 , [])),\
    )\
\
    sections = [_section_from_dict(s) \cf16 for\cf0  s \cf16 in\cf0  data.get(\cf15 "sections"\cf0 , [])]\
    \cf16 return\cf0  Document(meta=meta, sections=sections)\
