\cf16 from\cf0  __future__ \cf16 import\cf0  annotations\
\cf16 from\cf0  typing \cf16 import\cf0  \cf14 List\cf0 \
\cf16 from\cf0  .models \cf16 import\cf0  Document, Section, Paragraph, BulletList, CodeBlock, Block\
\
\
\cf16 def\cf0  \cf17 render_block\cf0 (block: Block) -> \cf18 str\cf0 :\
    \cf16 if\cf0  \cf18 isinstance\cf0 (block, Paragraph):\
        \cf16 return\cf0  block.text + \cf15 "\\n"\cf0 \
    \cf16 if\cf0  \cf18 isinstance\cf0 (block, BulletList):\
        \cf16 return\cf0  \cf15 "\\n"\cf0 .join(\cf15 f"- \{item\}\cf0 " \cf16 for\cf0  item \cf16 in\cf0  block.items) + \cf15 "\\n"\cf0 \
    \cf16 if\cf0  \cf18 isinstance\cf0 (block, CodeBlock):\
        \cf16 return\cf0  \cf15 f"```\{block.language\}\cf0 \\n\{block.code\}\\n```\\n"\
    \cf16 raise\cf0  TypeError(\cf15 f"Unknown block type: \{\cf18 type\cf0 (block)\}")\
\
\
\cf16 def\cf0  \cf17 render_section\cf0 (section: Section, level: \cf18 int\cf0  = \cf14 1\cf0 ) -> \cf18 str\cf0 :\
    \cf19 # level 1 -> "#", level 2 -> "##", etc.\cf0 \
    heading = \cf15 "#"\cf0  * level + \cf15 " "\cf0  + section.title + \cf15 "\\n\\n"\cf0 \
    body_parts: \cf14 List\cf0 [\cf18 str\cf0 ] = [heading]\
\
    \cf16 for\cf0  block \cf16 in\cf0  section.blocks:\
        body_parts.append(render_block(block))\
        body_parts.append(\cf15 "\\n"\cf0 )\
\
    \cf16 for\cf0  subsection \cf16 in\cf0  section.subsections:\
        body_parts.append(render_section(subsection, level + \cf14 1\cf0 ))\
\
    \cf16 return\cf0  \cf15 ""\cf0 .join(body_parts)\
\
\
\cf16 def\cf0  \cf17 render_document\cf0 (doc: Document) -> \cf18 str\cf0 :\
    parts: \cf14 List\cf0 [\cf18 str\cf0 ] = []\
\
    \cf19 # Frontmatter / title block\cf0 \
    parts.append(\cf15 f"# \{doc.meta.title\}\cf0 \\n\\n")\
    \cf16 if\cf0  doc.meta.author:\
        parts.append(\cf15 f"**Author:** \{doc.meta.author\}\cf0 \\n\\n")\
    \cf16 if\cf0  doc.meta.date:\
        parts.append(\cf15 f"**Date:** \{doc.meta.date\}\cf0 \\n\\n")\
    \cf16 if\cf0  doc.meta.keywords:\
        parts.append(\cf15 f"**Keywords:** "\cf0  + \cf15 ", "\cf0 .join(doc.meta.keywords) + \cf15 "\\n\\n"\cf0 )\
    parts.append(\cf15 "---\\n\\n"\cf0 )\
\
    \cf19 # Sections\cf0 \
    \cf16 for\cf0  sec \cf16 in\cf0  doc.sections:\
        parts.append(render_section(sec, level=\cf14 1\cf0 ))\
        parts.append(\cf15 "\\n"\cf0 )\
\
    \cf16 return\cf0  \cf15 ""\cf0 .join(parts)\
