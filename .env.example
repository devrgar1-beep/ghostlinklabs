# GhostLink Production Environment Configuration
# Copy this file to .env and update values as needed

# Application Settings
GHOSTLINK_ENV=production
PYTHONPATH=/app
LOG_LEVEL=INFO
DEBUG=false

# Database Configuration
DATABASE_URL=sqlite:///./ghostlink.db

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=3000
API_WORKERS=4

# AI Orchestrator Configuration
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
MAX_AI_SYSTEMS=9
RESOURCE_LIMITS=true

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_PASSWORD=ghostlink2025

# Security Settings
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here
API_KEY_EXPIRATION_DAYS=365
CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:443"]

# External API Keys (optional)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# ANTHROPIC_API_KEY=sk-ant-...

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION=7d

# Alert Configuration
ALERT_EMAIL=admin@ghostlink.local
SMTP_SERVER=localhost
SMTP_PORT=587