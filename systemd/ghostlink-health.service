[Unit]
Description=GhostLink Health Check
PartOf=ghostlink.service

[Service]
Type=oneshot
User=%u
Group=%u
Environment="GHOSTLINK_CONFIG_DIR=%C/ghostlink"
Environment="GHOSTLINK_DATA_DIR=%h/.local/share/ghostlink"
Environment="GHOSTLINK_LOG_DIR=%h/.local/share/ghostlink/logs"
ExecStart=%h/Library/Mobile\ Documents/com~apple~CloudDocs/ghostlinklabs/.venv/bin/python -m ghostlink.link_cli diagnostics health
StandardOutput=journal
StandardError=journal
