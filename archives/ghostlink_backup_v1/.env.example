# GhostLink Environment Configuration Example
# Copy this file to .env and customize as needed

# Database Configuration
DATABASE_URL=sqlite:///./ghostlink.db

# External API Keys
OPENAI_API_KEY=your_openai_api_key_here

# Security Settings
API_KEY_EXPIRATION_DAYS=365

# Application Settings
DEBUG=false

# ============================================================
# Automation Settings
# ============================================================

# AUTOMATE_ALL: Enable automatic execution of supported operations
# When true, components will run autonomously without manual confirmation
# Default: true
AUTOMATE_ALL=true

# AUTO_APPROVE: Enable automatic approval of actions requiring confirmation
# Use with caution in production environments
# Default: true
AUTO_APPROVE=true

# EXPERIMENTAL_MODE: Control experimental feature access
# Valid values: 'off', 'partial', 'full'
# - 'off': Disable all experimental features
# - 'partial': Enable select safe experimental features
# - 'full': Enable all experimental features
# Default: full
EXPERIMENTAL_MODE=full

# ============================================================
# Example Configurations for Different Environments
# ============================================================

# Production (conservative):
# AUTOMATE_ALL=false
# AUTO_APPROVE=false
# EXPERIMENTAL_MODE=off
# DEBUG=false

# Staging (selective automation):
# AUTOMATE_ALL=true
# AUTO_APPROVE=false
# EXPERIMENTAL_MODE=partial
# DEBUG=true

# Development (fully automated):
# AUTOMATE_ALL=true
# AUTO_APPROVE=true
# EXPERIMENTAL_MODE=full
# DEBUG=true
