{
    "name": "ghostlink-vscode",
    "displayName": "GhostLink AI Integration",
    "description": "VS Code extension for GhostLink AI system integration - Real-time AI assistance and system control",
    "version": "1.0.0",
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other",
        "AI",
        "Machine Learning"
    ],
    "activationEvents": [
        "onCommand:ghostlink.health",
        "onCommand:ghostlink.task",
        "onCommand:ghostlink.status",
        "onCommand:ghostlink.consciousness",
        "onCommand:ghostlink.multiagent",
        "onCommand:ghostlink.deploy"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "ghostlink.health",
                "title": "GhostLink: Show System Health",
                "category": "GhostLink"
            },
            {
                "command": "ghostlink.task",
                "title": "GhostLink: Execute AI Task",
                "category": "GhostLink"
            },
            {
                "command": "ghostlink.status",
                "title": "GhostLink: System Status",
                "category": "GhostLink"
            },
            {
                "command": "ghostlink.apiStatus",
                "title": "GhostLink: API Status",
                "category": "GhostLink"
            },
            {
                "command": "ghostlink.consciousness",
                "title": "GhostLink: Consciousness Analysis",
                "category": "GhostLink"
            },
            {
                "command": "ghostlink.multiagent",
                "title": "GhostLink: Multi-Agent Status",
                "category": "GhostLink"
            },
            {
                "command": "ghostlink.deploy",
                "title": "GhostLink: Deploy Infrastructure",
                "category": "GhostLink"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "ghostlink.health",
                    "when": "workspaceFolderCount != 0"
                },
                {
                    "command": "ghostlink.task",
                    "when": "workspaceFolderCount != 0"
                },
                {
                    "command": "ghostlink.status",
                    "when": "workspaceFolderCount != 0"
                },
                {
                    "command": "ghostlink.consciousness",
                    "when": "workspaceFolderCount != 0"
                },
                {
                    "command": "ghostlink.multiagent",
                    "when": "workspaceFolderCount != 0"
                },
                {
                    "command": "ghostlink.deploy",
                    "when": "workspaceFolderCount != 0"
                }
            ]
        },
        "configuration": {
            "title": "GhostLink AI Integration",
            "properties": {
                "ghostlink.pythonPath": {
                    "type": "string",
                    "default": "python3",
                    "description": "Path to Python executable for GhostLink integration"
                },
                "ghostlink.projectRoot": {
                    "type": "string",
                    "default": "",
                    "description": "Path to GhostLink project root directory"
                },
                "ghostlink.vscodeApiUrl": {
                    "type": "string",
                    "default": "http://localhost:3000",
                    "description": "VS Code HTTP API URL"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.74.0",
        "@types/node": "16.x",
        "eslint": "^8.28.0",
        "@typescript-eslint/eslint-plugin": "^5.42.0",
        "@typescript-eslint/parser": "^5.42.0",
        "typescript": "^4.9.3"
    },
    "dependencies": {
        "axios": "^1.3.4"
    }
}
