# Example environment variables for GhostLink (do NOT commit real secrets)
# Copy to .env and fill with real values in your deployment environment

# Required provider API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
GOOGLE_API_KEY=

# Application secrets
JWT_SECRET=
ADMIN_API_KEY=
SECRET_KEY=

# Database
POSTGRES_PASSWORD=

# Grafana
GRAFANA_PASSWORD=

# Performance & openness profile
# Options: conservative (default), low-latency, open
GHOSTLINK_PERF_PROFILE=
# You can also set: maximized or turbo for extreme performance (use with caution)
# GHOSTLINK_PERF_PROFILE=maximized
# When set to true, allows more relaxed sandbox/network policies
GHOSTLINK_OPEN_NETWORK=
# Tunables
GHOSTLINK_REQUEST_TIMEOUT=
GHOSTLINK_MAX_WORKERS=

# UI transparency (dashboard)
GHOSTLINK_UI_TRANSPARENT=
GHOSTLINK_UI_ALPHA=
