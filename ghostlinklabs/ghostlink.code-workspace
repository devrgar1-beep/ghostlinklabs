{
    "folders": [
        {
            "path": ".",
            "name": "GhostLink"
        }
    ],
    "settings": {
        "files.exclude": {
            "**/__pycache__": true,
            "**/*.pyc": true,
            "**/.pytest_cache": true,
            "**/.mypy_cache": true,
            "**/.ruff_cache": true
        }
    },
    "extensions": {
        "recommendations": [
            "ms-python.python",
            "github.copilot",
            "github.copilot-chat",
            "ms-vscode.powershell"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Start GhostLink",
                "type": "shell",
                "command": "python -m ghostlink.main",
                "problemMatcher": [],
                "group": {
                    "kind": "build",
                    "isDefault": true
                }
            },
            {
                "label": "Run Tests",
                "type": "shell",
                "command": "pytest",
                "problemMatcher": [],
                "group": "test"
            },
            {
                "label": "Lattice Demo",
                "type": "shell",
                "command": "python ghostlink_lattice.py --demo",
                "problemMatcher": []
            }
        ]
    }
}