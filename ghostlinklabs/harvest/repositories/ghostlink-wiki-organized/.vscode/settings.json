{
    "python.defaultInterpreterPath": "python3",
    "python.formatting.provider": "black",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "python.linting.flake8Enabled": true,
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "wolfram.defaultKernel": "Local",
    "wolfram.notebook.enableExperimental": true,
    "wolfram.completion.enable": true,
    "wolfram.hover.enable": true,
    "docker.showStartPage": false,
    "docker.containers.groupBy": "Compose Project Name",
    "docker.images.groupBy": "Repository",
    "remote.containers.enable": true,
    "remote.containers.defaultExtensions": [
        "ms-python.python",
        "wolfram.wolfram",
        "ms-vscode.vscode-json",
        "ms-vscode-remote.remote-containers",
        "ms-vscode.vscode-docker",
        "ms-vscode-remote.remote-ssh"
    ],
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.enableCommitSigning": true,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
        "source.fixAll": "explicit"
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "files.associations": {
        "*.m": "wolfram",
        "*.nb": "wolfram",
        "*.wl": "wolfram",
        "Dockerfile*": "dockerfile",
        "*.yml": "yaml",
        "*.yaml": "yaml"
    },
    "emmet.includeLanguages": {
        "wolfram": "html"
    },
    "ghostlink.experimentalMode": true,
    "ghostlink.hybridTriad": true,
    "ghostlink.localFirst": true,
    "ghostlink.sovereign": true,
    "ghostlink.mathematicaIntegration": true,
    "ghostlink.dockerEnabled": true,
    "ghostlink.automationEnabled": true,
    "extensions.recommendations": [
        "ms-python.python",
        "wolfram.wolfram",
        "ms-vscode.vscode-json",
        "ms-vscode-remote.remote-containers",
        "ms-vscode.vscode-docker",
        "ms-vscode-remote.remote-ssh",
        "ms-vscode.vscode-yaml",
        "ms-vscode.git-graph",
        "ms-vscode-remote.remote-wsl",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "ms-vscode.makefile-tools",
        "ms-vscode.vscode-typescript-next",
        "github.copilot",
        "github.copilot-chat"
    ],
    "launch": {
        "configurations": [
            {
                "name": "Docker: Build and Run",
                "type": "docker",
                "request": "launch",
                "preLaunchTask": "docker-run",
                "removeContainerAfterDebug": true
            }
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "docker-build",
                "type": "shell",
                "command": "docker",
                "args": [
                    "build",
                    "-t",
                    "ghostlink:local",
                    "."
                ],
                "group": "build",
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "shared"
                }
            },
            {
                "label": "docker-run",
                "type": "shell",
                "command": "docker",
                "args": [
                    "run",
                    "--rm",
                    "-p",
                    "8000:8000",
                    "ghostlink:local"
                ],
                "group": "build",
                "dependsOn": [
                    "docker-build"
                ]
            },
            {
                "label": "docker-compose-up",
                "type": "shell",
                "command": "docker-compose",
                "args": [
                    "up",
                    "-d"
                ],
                "group": "build"
            },
            {
                "label": "mathematica-test",
                "type": "shell",
                "command": "wolframscript",
                "args": [
                    "-code",
                    "Get[\"mathematica/GhostLink.m\"]; Print[\"Test passed\"]"
                ],
                "group": "test"
            },
            {
                "label": "hybrid-triad-setup",
                "type": "shell",
                "command": "python",
                "args": [
                    "scripts/setup_hybrid_triad.py"
                ],
                "group": "build"
            }
        ]
    }
}
