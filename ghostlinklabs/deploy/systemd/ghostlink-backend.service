[Unit]
Description=GhostLink Backend API Service
After=network.target ghostlink-controller.service
Wants=network-online.target

[Service]
Type=simple
User=ghostlink
Group=ghostlink
WorkingDirectory=/opt/ghostlink/backend
Environment="PATH=/opt/ghostlink/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HOST=0.0.0.0"
Environment="PORT=8000"
ExecStart=/opt/ghostlink/.venv/bin/python /opt/ghostlink/backend/main.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/ghostlink/backend.log
StandardError=append:/var/log/ghostlink/backend.log

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/ghostlink

[Install]
WantedBy=multi-user.target
