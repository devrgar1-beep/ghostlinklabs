#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
cd "$ROOT_DIR"

usage() {
  cat <<USAGE
GhostLink control tool

Usage: glctl <command>

Local runtime:
  up                        Start tmux-based local runtime (controller+peer)
  down                      Stop local runtime
  status                    Show socket status and logs tail
  logs                      Tail controller/peer logs

Docker runtime:
  docker:build              Build Docker image (ghostlink:latest)
  docker:up                 Start docker-compose (controller only by default)
  docker:down               Stop docker-compose
  docker:logs               Tail docker container logs
  docker:mesh               Enable mesh + responder (compose reload)
  docker:peer               Enable peer sensor streamer (compose reload)

Backbone helpers:
  backbone:deploy           Deploy responder to hosts in backbone_hosts.txt
  backbone:discover <cidr>  Discover responders on CIDR(s) -> creds/neighbors.txt
  neighbors:use-file        Point .env at /run/ghostlink/neighbors.txt

iDRAC operations:
  idrac:discover <cidr>     Discover iDRACs on management network
  idrac:status <host>       Show power state and health of iDRAC host
  idrac:power-on <host>     Power on R630 via iDRAC
  idrac:power-off <host>    Power off R630 (graceful)
  idrac:reset <host>        Reboot R630 (graceful)
  idrac:thermal <host>      Show temperature sensors
  idrac:health <host>       Show detailed health (PSU, fans, SEL)
  idrac:monitor             Start continuous health monitoring daemon

Utilities:
  doctor                    Run health checks (ports, metrics)
  install-docker            Install Docker Engine + Compose (Ubuntu)
USAGE
}

cmd=${1:-}
case "$cmd" in
  up)               bash run_venv.sh up ;;
  down)             bash run_venv.sh down ;;
  status)           bash run_venv.sh status ;;
  logs)             bash run_venv.sh logs ;;

  docker:build)     docker build -t ghostlink:latest . ;;
  docker:up)        docker compose up -d ;;
  docker:down)      docker compose down ;;
  docker:logs)      docker logs -f ghostlink ;;
  docker:mesh)
    # Toggle mesh/responder on via compose override using envsubst path
    echo "Enabling mesh + responder in docker-compose.yml"
    sed -i 's/RUN_MESH=0/RUN_MESH=1/' docker-compose.yml
    sed -i 's/RUN_RESPONDER=0/RUN_RESPONDER=1/' docker-compose.yml
    docker compose up -d --build
    ;;
  docker:peer)
    echo "Enabling peer in docker-compose.yml"
    sed -i 's/RUN_PEER=0/RUN_PEER=1/' docker-compose.yml
    docker compose up -d --build
    ;;

  backbone:deploy)
    scripts/deploy_responder.sh backbone_hosts.txt
    ;;
  backbone:discover)
    shift || true
    if [[ $# -eq 0 ]]; then echo "Usage: glctl backbone:discover <cidr> [cidr...]"; exit 2; fi
    OUT_FILE=./creds/neighbors.txt scripts/discover_backbone.py "$@"
    ;;
  neighbors:use-file)
    if grep -q '^NEIGHBORS_FILE=' .env; then sed -i 's#^NEIGHBORS_FILE=.*#NEIGHBORS_FILE=/run/ghostlink/neighbors.txt#' .env; else echo 'NEIGHBORS_FILE=/run/ghostlink/neighbors.txt' >> .env; fi
    if grep -q '^NEIGHBOR_IPS=' .env; then sed -i 's/^NEIGHBOR_IPS=.*/NEIGHBOR_IPS=/' .env; fi
    echo 'Updated .env to use NEIGHBORS_FILE=/run/ghostlink/neighbors.txt. Ensure ./creds/neighbors.txt exists.'
    ;;

  idrac:discover)
    shift || true
    if [[ $# -eq 0 ]]; then echo "Usage: glctl idrac:discover <mgmt_cidr> [cidr...]"; exit 2; fi
    scripts/discover_idrac.py "$@"
    ;;
  idrac:status)
    shift || true
    if [[ $# -eq 0 ]]; then echo "Usage: glctl idrac:status <idrac_host>"; exit 2; fi
    scripts/idrac_ctl.sh status "$1"
    ;;
  idrac:power-on)
    shift || true
    if [[ $# -eq 0 ]]; then echo "Usage: glctl idrac:power-on <idrac_host>"; exit 2; fi
    scripts/idrac_ctl.sh power-on "$1"
    ;;
  idrac:power-off)
    shift || true
    if [[ $# -eq 0 ]]; then echo "Usage: glctl idrac:power-off <idrac_host>"; exit 2; fi
    scripts/idrac_ctl.sh power-off "$1"
    ;;
  idrac:reset)
    shift || true
    if [[ $# -eq 0 ]]; then echo "Usage: glctl idrac:reset <idrac_host>"; exit 2; fi
    scripts/idrac_ctl.sh reset "$1"
    ;;
  idrac:thermal)
    shift || true
    if [[ $# -eq 0 ]]; then echo "Usage: glctl idrac:thermal <idrac_host>"; exit 2; fi
    scripts/idrac_ctl.sh thermal "$1"
    ;;
  idrac:health)
    shift || true
    if [[ $# -eq 0 ]]; then echo "Usage: glctl idrac:health <idrac_host>"; exit 2; fi
    scripts/idrac_ctl.sh health "$1"
    ;;
  idrac:monitor)
    python3 gl_idrac_monitor.py
    ;;

  doctor)
    echo "-- sockets --" && (ss -ltnp 2>/dev/null || true) | egrep ':7420|:7422|:9108' || true
    echo "-- metrics --" && curl -fsS http://127.0.0.1:9108/metrics | head -n 10 || true
    ;;
  install-docker)
    bash scripts/provision_docker.sh
    ;;
  *) usage; exit 2 ;;
esac
