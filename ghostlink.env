# /etc/default/ghostlink — central config
# Bindings
HOST=10.7.0.1
PORT=7420
PROMETHEUS_BIND=127.0.0.1:9108

# Control knobs
GL_WINDOW_SEC=20
GL_GOOD_MAX_C=80.0
GL_SCAR_HOT_C=85.0
GL_SCAR_SUSTAIN_SEC=5
GL_ACTIVITY_CAP=0.07
GL_SCAR_CAP=0

# Optional OpenAI
# OPENAI_API_KEY=sk-...
GL_MODEL=gpt-4.1-mini

# Groq API - Internal Communication AI
# Ultra-fast inference for autonomous component coordination
GROQ_API_KEY=[REDACTED_GROQ_API_KEY]
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_PURPOSE=internal_communication

# TLS (mTLS) paths if enabled
# GL_TLS_CERT=/etc/ghostlink/ctl.crt
# GL_TLS_KEY=/etc/ghostlink/ctl.key
# GL_TLS_CA=/etc/ghostlink/ca.crt
